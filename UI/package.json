{
  "name": "ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "qa": "node scripts/qa.mjs",
    "qa:hover": "node scripts/qa-hover.mjs http://localhost:5174 light && node scripts/qa-hover.mjs http://localhost:5174 dark",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
