     "choices": []
    },
    {
     "key": "gross_weight",
     "label": "Gross weight",
     "type": "text",
     "required": false,
     "hint": "with its unit as printed",
     "pattern": "",
     "choices": []
    },
    {
     "key": "exchange_rate",
     "label": "Exchange rate",
     "type": "text",
     "required": false,
