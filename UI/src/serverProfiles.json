    },
    {
     "key": "sub_total",
     "label": "Total before tax",
     "type": "amount",
     "required": false,
     "hint": "",
     "pattern": "",
     "choices": []
    },
    {
     "key": "tax_total",
     "label": "Total tax",
     "type": "amount",
     "required": false,
     "hint": "",
     "pattern": "",
     "choices": []
    },
    {
     "key": "total",
     "label": "Invoice total",
     "type": "amount",
     "required": true,
     "hint": "the grand total payable",
     "pattern": "",
     "choices": []
    }
   ],
   "tables": [
    {
     "key": "charges",
     "label": "the charge lines",
     "columns": [
      "Description",
      "Amount"
     ],
     "required": true,
     "hint": "one row per charge; Amount is the line's taxable value before tax, as printed"
    }
   ],
   "checks": [
    {
     "type": "sum",
     "table": "charges",
     "column": "Amount",
     "field": "sub_total",
     "tolerance": 1,
