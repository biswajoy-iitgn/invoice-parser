    },
    {
     "type": "field_formula",
     "result": "total",
     "expr": "subtotal + taxtotal",
     "tolerance": 1,
     "name": "total is the subtotal plus tax"
    },
    {
     "type": "date_window",
     "field": "invoice_date",
     "max_age_days": 730,
     "name": "invoice date is recent and not in the future"
    }
